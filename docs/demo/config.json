{
  "project": {
    "id": "tiny_pets",
    "name": "Tiny Pets",
    "default_config": "configs/tiny_pets_demo.yaml",
    "dataset_id": "tiny_pets_v1",
    "checkpoint_key": "universal-yolo-tiny-pets-checkpoint-v3"
  },
  "seed": 8,
  "device": "browser-cpu",
  "classes": ["cat", "dog"],
  "model": {
    "image_size": 48,
    "backbone": "tiny-linear-demo",
    "pretrained_backbone": false,
    "fpn_channels": 16,
    "head_channels": 16,
    "freeze_backbone_epochs": 0
  },
  "data": {
    "source": "bundled",
    "root": "docs/demo/tiny_pets",
    "train_samples": 8,
    "val_samples": 8,
    "seed": 8
  },
  "augmentation": {
    "enabled": false,
    "hflip_p": 0,
    "hsv_h": 0,
    "hsv_s": 0,
    "hsv_v": 0
  },
  "loss": {
    "obj_weight": 1,
    "cls_weight": 1,
    "box_weight": 1,
    "l1_weight": 0,
    "focal_alpha": 0.25,
    "focal_gamma": 2,
    "center_radius": 1
  },
  "train": {
    "run_name": "main",
    "output_dir": "browser://tiny_pets/runs",
    "epochs": 160,
    "batch_size": 8,
    "learning_rate": 0.12,
    "total_steps": 160,
    "amp": false
  },
  "note": "Educational two-class photo detector"
}
